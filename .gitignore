# Terraform
**/.terraform/*
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
tfplan
*.tfplan
*.log

# Generated SSH keys - never commit
ssh/
*.pem
*.ppk
id_rsa*
id_ed25519*

# Discovery output (contains account/resource identifiers)
discovery.json
discovery/

# Local route dumps from scripts/04-routes.* (contain live public IPs)
routes.txt
routes-*.txt

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
