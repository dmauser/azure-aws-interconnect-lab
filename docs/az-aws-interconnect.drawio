        <mxCell id="e1" value="VNet peering&#10;gateway transit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078D4;strokeWidth=2;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;endArrow=block;startArrow=block;endFill=1;startFill=1;" edge="1" parent="1" source="azvm" target="ergw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="ExpressRoute connection&#10;conn-mcilab-to-aws" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078D4;strokeWidth=2;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;endArrow=block;startArrow=block;endFill=1;startFill=1;" edge="1" parent="1" source="ergw" target="ckt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="managed underlay&#10;4 &#215; ECMP &#183; MACsec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52525B;strokeWidth=3;dashed=1;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;endArrow=block;startArrow=block;endFill=1;startFill=1;" edge="1" parent="1" source="ckt" target="mcc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="DXGW association" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ED7100;strokeWidth=2;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;endArrow=block;startArrow=block;endFill=1;startFill=1;" edge="1" parent="1" source="mcc" target="dxgw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="attached" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ED7100;strokeWidth=2;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;endArrow=block;startArrow=block;endFill=1;startFill=1;" edge="1" parent="1" source="dxgw" target="vgw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="route propagation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ED7100;strokeWidth=2;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;endArrow=block;startArrow=block;endFill=1;startFill=1;" edge="1" parent="1" source="vgw" target="awsvm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="latency samples&#10;HTTP POST over the peering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0E7490;strokeWidth=2;dashed=1;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;endArrow=block;startArrow=none;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="aci" target="azvm">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="92" y="397" />
              <mxPoint x="92" y="285" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="dashboard&#10;TCP 8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0E7490;strokeWidth=2;dashed=1;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;endArrow=block;startArrow=none;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="operator" target="azvm">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="50" y="563" />
              <mxPoint x="50" y="253" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Why two Azure regions - the hub/spoke split is forced, not a preference&lt;/b&gt;&#10;The ExpressRoute gateway must sit in East US: a MultiCloud-tier circuit is evaluated as a Local circuit and attaches only to the region matching its peering location (useast). But this subscription has no VM capacity in East US - all 1420 sizes are restricted at type: Location, which is capacity and not quota - so the VM had to land in East US 2. Gateways are not VMs, so only the VM had to move; the spoke reaches AWS through the hub gateway via peering with allow_gateway_transit and use_remote_gateways. If your subscription can build VMs in East US, set azure_location = &quot;eastus&quot; and the two VNets collapse into one.&#10;&#10;&lt;b&gt;Prefixes exchanged over the interconnect&lt;/b&gt;&#10;&#9654; Azure advertises 10.100.0.0/24 (hub) and 10.100.1.0/24 (spoke). The spoke prefix only appears when the peering sets use_remote_gateways.&#10;&#9664; AWS advertises 10.200.0.0/16. Seen on the gateway as Origin EBgp, asPath 12076-64512, across 4 ECMP next hops 10.100.0.4 - 10.100.0.7.&#10;Both directions must be true independently. One missing direction fails ping one way only, which looks exactly like a firewall problem.&#10;&#10;&lt;b&gt;Measurement plane (dashed teal) - observes the path, never carries it&lt;/b&gt;&#10;Two vantage points probe the same target, the AWS EC2 private IP: ci-mcilab-probe beside the gateway in the East US hub, and vm-mcilab-azure in the East US 2 spoke. Both POST their samples to the collector on 10.100.1.4:8080 across the hub/spoke peering. The dashboard on that same port is reachable from the VM public IP, restricted by NSG to the operator /32.&#10;The hub vantage point is roughly 4.1 ms faster at p50 - that difference is the latency cost of the forced region split. Nothing here touches the circuit, the interconnect, the DXGW or the gateway." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1;dashed=0;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="200" y="524" width="1440" height="250" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

